# ------------------------------------------------------------------
# Supabase — wymagane
# Project Settings → API w panelu https://supabase.com/dashboard
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-anon-public-key

# ------------------------------------------------------------------
# AI-trener — opcjonalne
# Klucz z https://console.anthropic.com  (płatny per użycie).
# Bez tego formularz „Poproś AI o plan” zwróci czytelny komunikat,
# a reszta aplikacji działa normalnie.
# ------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# ------------------------------------------------------------------
# Import katalogu ćwiczeń z wger — opcjonalne, tylko lokalnie
# Service role key (Project Settings → API → service_role).
# NIGDY nie wrzucaj tego klucza do Vercela ani do repozytorium —
# omija Row Level Security.
# ------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ------------------------------------------------------------------
# Płatności Stripe — opcjonalne
# Bez tych kluczy ekran subskrypcji mówi „płatności jeszcze nie
# działają", a reszta aplikacji chodzi normalnie.
#
# STRIPE_PRICE_ID: identyfikator ceny (Products → wybrany produkt → Pricing).
# STRIPE_WEBHOOK_SECRET: z Developers → Webhooks → punkt /api/stripe/webhook.
#   Nasłuchuj zdarzeń: checkout.session.completed oraz customer.subscription.*
# ------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------
# Sekret furtki, przez którą webhook zapisuje stan subskrypcji.
#
# CELOWO nie jest to service_role key Supabase — tamten omija całe RLS,
# więc jego wyciek oznaczałby dostęp do dzienników zdrowia wszystkich
# użytkowników. Ten sekret pozwala wyłącznie ustawić stan subskrypcji.
#
# Wygeneruj dowolny długi ciąg i wpisz go po obu stronach:
#   1. tutaj (oraz w zmiennych środowiskowych Vercela),
#   2. w bazie:  select private.set_config_value('stripe_webhook_secret', '...');
# ------------------------------------------------------------------
# SUPABASE_WEBHOOK_SECRET=dowolny-dlugi-losowy-ciag

# ------------------------------------------------------------------
# Adres aplikacji — potrzebny Stripe'owi do powrotu po płatności.
# Na Vercelu wykrywany automatycznie; ustaw tylko lokalnie lub przy
# własnej domenie.
# ------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://grind-app-iota.vercel.app
