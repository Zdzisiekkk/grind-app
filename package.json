{
  "name": "grind-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node scripts/test-db.mjs",
    "validate:sql": "node scripts/validate-migrations.mjs",
    "import:wger": "node scripts/import-wger.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "db:push": "node scripts/run-migrations.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:offline": "node --no-warnings scripts/test-offline.mjs",
    "verify:plan": "node scripts/verify-plan-import.mjs",
    "test:analysis": "node --no-warnings --import ./scripts/register-alias.mjs scripts/test-analysis.mjs",
    "test:vices": "node --no-warnings --import ./scripts/register-alias.mjs scripts/test-vices.mjs",
    "test:isbn": "node --no-warnings --import ./scripts/register-alias.mjs scripts/test-isbn.mjs",
    "test:daty": "TZ=UTC node --no-warnings --import ./scripts/register-alias.mjs scripts/test-daty.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "date-fns": "^4.4.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "stripe": "^22.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
